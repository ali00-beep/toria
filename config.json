{
  "hotkey": "F9",
  "recordings_folder": "workspace",
  "whisper_model": "medium",
  "whisper_device": "cuda",
  "beam_size": 5,
  "language": "ru",
  "initial_prompt": "Голосовые команды компьютеру: напиши скрипт, Python, папка, файл, рабочий стол, корзина, открой, создай, запусти.",
  "dispatcher": {
    "provider": "ollama",
    "base_url": "http://localhost:11434/v1",
    "model": "qwen2.5:7b",
    "temperature": 0.2
  },
  "dispatcher_deepseek": {
    "provider": "deepseek",
    "base_url": "https://api.deepseek.com/v1",
    "model": "CHANGE_ME",
    "api_key_env": "DEEPSEEK_API_KEY"
  },
  "executor": {
    "provider": "ollama",
    "base_url": "http://localhost:11434/v1",
    "model": "qwen2.5-coder:7b",
    "temperature": 0.2
  },
  "voice_activation": {
    "always_listen": true,
    "wake_words": ["тора", "ториа", "тори", "алиса", "але", "алё", "алеса"],
    "wake_response": "Да, слушаю.",
    "voice_threshold": 0.03,
    "silence_duration": 0.8,
    "command_timeout": 8.0,
    "min_voice_duration": 0.25,
    "min_speech_duration": 0.5
  },
  "tts": {
    "engine": "edge",
    "voice": "ru-RU-SvetlanaNeural",
    "speed": 1.0
  }
}
